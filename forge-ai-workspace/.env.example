# Environment — copy to .env and fill in values

# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge_ai

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-min-32-chars-long-secret-key
JWT_REFRESH_SECRET=change-me-different-min-32-chars-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256-GCM) — must be exactly 32 chars
ENCRYPTION_KEY=change-me-exactly-32-characters!!

# OpenAI (optional — users configure their own keys)
OPENAI_API_KEY=
